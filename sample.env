# Required — the LLM agents run through the KI:connect.nrw proxy using this key
# (mobility_advisor/env.py derives OPENAI_API_KEY/OPENAI_API_BASE from it).
KICONNECT_API_KEY=your_kiconnect_api_key_here

# Optional — real routing distances instead of a haversine estimate
# (mobility_advisor/integrations/ors.py).
ORS_API_KEY=your_openrouteservice_api_key_here

# Optional — live Outlook calendar ingestion. Currently unreachable in practice:
# mobility_advisor/store/loaders.py hardcodes USE_MOCK_DATA = True, so these are only
# relevant if you flip that flag.
OUTLOOK_CLIENT_ID=your_outlook_client_id_here
OUTLOOK_TENANT_ID=your_outlook_tenant_id_here

# GOOGLE_GENAI_USE_VERTEXAI / GOOGLE_API_KEY intentionally omitted: this project's LLM
# path is LiteLlm -> KIConnect, not native Gemini, so no project code reads them.
